# Server Configuration
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/spendsync

# Better Auth Configuration
AUTH_SECRET=your-super-secret-key-minimum-32-characters-long
AUTH_TRUST_HOST=true
AUTH_SESSION_EXPIRY=7d

# Email Configuration (for email verification & password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@spendsync.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=info

# ── AI assistant: free models, tried in this order (add as many keys as you like; one is enough to start) ──
# Gemma 4 on Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free fallbacks — each key adds one more safety net:
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# Override the order without a code change, e.g. gemini:gemma-4-31b-it,groq:llama-3.3-70b-versatile
# ASSISTANT_CHAIN=
# Paid last resort (Claude Haiku). Off unless you set this to true AND provide ANTHROPIC_API_KEY.
# ASSISTANT_ALLOW_PAID=false
# ANTHROPIC_API_KEY=

# Support emails. SUPPORT_EMAIL_TO = who receives reports (comma-separated, required: nothing is hardcoded).
# SMTP_USER/SMTP_PASSWORD = the mailbox that sends them (Gmail: use an App Password). EMAIL_FROM = a plain address.
# The SMTP_* and EMAIL_FROM lines are in the Email section near the top of this file.
SUPPORT_EMAIL_TO=

# ── Bills (Cloudinary): photos/PDFs of bills. Without these three, bills are switched off (503). ──
# Dashboard → Settings → API Keys. Keep the secret server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Protects /api/cron/bills. Set the same value in Vercel → Settings → Environment Variables (Vercel cron sends it).
CRON_SECRET=
# Per-user limits (bytes stored incl. Trash; uploads per UTC day).
BILLS_MAX_BYTES_PER_USER=524288000
BILLS_MAX_UPLOADS_PER_DAY=50
